# Copy to .env. `uv run otel2dbx demo init` fills the local-stack secrets securely.
# .env is gitignored; never commit real values.
POSTGRES_PASSWORD=replace-me
CLICKHOUSE_PASSWORD=replace-me
REDIS_AUTH=replace-me
MINIO_ROOT_PASSWORD=replace-me
SALT=replace-me
ENCRYPTION_KEY=replace-with-64-hex-characters
NEXTAUTH_SECRET=replace-me
LANGFUSE_PUBLIC_KEY=lf_pk_replace-me
LANGFUSE_SECRET_KEY=lf_sk_replace-me
LANGFUSE_AUTH_HEADER=Basic replace-me
LANGFUSE_USER_EMAIL=demo@example.com
LANGFUSE_USER_PASSWORD=replace-me
LANGFUSE_BASE_URL=http://localhost:3000

# Zerobus OTLP endpoint. WORKSPACE_ID is the o= number in your workspace URL; leave it
# blank to auto-derive from the authenticated profile. REGION is your workspace region.
# CLIENT_ID/SECRET are written by `uv run otel2dbx zerobus bootstrap` (or `setup`).
ZEROBUS_WORKSPACE_ID=
ZEROBUS_REGION=us-east-1
ZEROBUS_CLIENT_ID=replace-with-service-principal-application-id
ZEROBUS_CLIENT_SECRET=replace-with-service-principal-oauth-secret

# Optional: Databricks secret scope holding the four ZEROBUS_* values, written by
# `uv run otel2dbx setup --secret-scope ...`. Bundle jobs use this instead of .env.
# OTEL2DBX_SECRET_SCOPE=otel2dbx

# Optional: set these to run the demo/migration commands zero-config against your own
# workspace (otherwise pass them as --profile / --experiment-id / --warehouse-id flags).
# OTEL2DBX_DATABRICKS_PROFILE=DEFAULT
# OTEL2DBX_EXPERIMENT_ID=
# OTEL2DBX_WAREHOUSE_ID=
# OTEL2DBX_MODEL_ENDPOINT=databricks-kimi-k3
