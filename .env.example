# Copy to .env (gitignored). `uv run otel2dbx setup ...` fills these in for you; you can
# also set them by hand. Never commit real values.

# Zerobus OTLP ingestion endpoint + service-principal OAuth credentials.
# WORKSPACE_ID is the o= number in your workspace URL; leave it blank to auto-derive from
# the authenticated profile. REGION is your workspace region. CLIENT_ID/SECRET are written
# by `uv run otel2dbx setup` (or `zerobus bootstrap`).
ZEROBUS_WORKSPACE_ID=
ZEROBUS_REGION=us-east-1
ZEROBUS_CLIENT_ID=replace-with-service-principal-application-id
ZEROBUS_CLIENT_SECRET=replace-with-service-principal-oauth-secret

# Optional: Databricks secret scope holding the four ZEROBUS_* values, written by
# `uv run otel2dbx setup --secret-scope ...`. Bundle jobs read this instead of .env.
# OTEL2DBX_SECRET_SCOPE=otel2dbx

# Destination selection. `otel2dbx setup` writes EXPERIMENT_ID and WAREHOUSE_ID here so
# later commands run zero-config; otherwise pass them as --experiment-id / --warehouse-id.
# OTEL2DBX_DATABRICKS_PROFILE=DEFAULT
# OTEL2DBX_EXPERIMENT_ID=
# OTEL2DBX_WAREHOUSE_ID=
